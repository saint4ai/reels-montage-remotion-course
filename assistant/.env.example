# Скопируй в .env и заполни. Файл .env секретный: он не попадает в репозиторий и лежит только у тебя и на сервере.
# Ключи в чат с агентом не вставляй: сохрани в Загрузки\<сервис>-key.txt и скажи агенту, что файл лежит.

# ── Zernio (директ и комментарии Instagram, WhatsApp, Telegram) ──────────────────────────────
# Где взять: docs/guides/zernio.md. Ключ с правами read-write и группами messages и webhooks.
ZERNIO_API_KEY=
# Секрет подписи вебхука. Его придумываешь ты (точнее, агент): длинная случайная строка, от 32 знаков.
# Например: python -c "import secrets; print(secrets.token_hex(32))"
ZERNIO_WEBHOOK_SECRET=

# ── Модель (OpenAI или любой совместимый адрес) ──────────────────────────────────────────────
# Где взять: docs/guides/openai.md.
OPENAI_API_KEY=
# Имя модели оставь пустым, пока не выбрал: смотри docs/guides/openai.md (там недорогая модель для ответов).
OPENAI_MODEL=
# По умолчанию OpenAI. Из России можно через OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1,
# ключ OpenRouter в OPENAI_API_KEY, модель вида openai/<модель>. Голосовые и картинки работают не на всех
# адресах: python -m app.check скажет, что не работает, и тогда их выключают в config/assistant.toml.
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Telegram (заявки владельцу и кнопки под ними) ────────────────────────────────────────────
# Где взять: docs/guides/telegram-bot.md. Токен бота от BotFather и id чата, куда бот пишет заявки.
TELEGRAM_BOT_TOKEN=
TELEGRAM_LEAD_CHAT_ID=

# ── Сервер ───────────────────────────────────────────────────────────────────────────────────
# Адрес, по которому Zernio достучится до вебхука. Нет своего домена: <ip-сервера>.sslip.io
# (например 203-0-113-10.sslip.io, точки в IP заменяются дефисами). Где взять сервер: docs/guides/server-vps.md.
DOMAIN=

# ── Необязательное ───────────────────────────────────────────────────────────────────────────
# 0: ассистент не отвечает на вопросы (материал по кодовому слову всё равно уходит)
ASSISTANT_ENABLED=1
LOG_LEVEL=INFO
