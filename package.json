{
  "name": "onai-reels-remotion-course",
  "version": "1.0.0",
  "private": true,
  "description": "Учебный Remotion-пайплайн для автомонтажа вертикальных Reels",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "doctor": "node scripts/doctor.mjs",
    "new": "node scripts/new-project.mjs",
    "frames": "node scripts/render-approval-frames.mjs",
    "render": "remotion render src/index.ts Reel out/reel.mp4 --codec=h264 --crf=16 --concurrency=2",
    "still": "remotion still src/index.ts Reel out/preview.png --frame=150",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.527",
    "remotion": "4.0.527",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  }
}
